    #feedback-wrapper { width:100%; display:flex; justify-content:center; }
    #feedback-form-widget { width:100%; max-width:900px; display:flex; flex-direction:column; gap:12px; }

    .feedback-card {
      background: linear-gradient(135deg,#053a54,#016a90);
      color:#fff;
      border-radius:15px;
      padding:18px 22px;
      box-shadow:0 6px 20px rgba(0,0,0,0.35);
      display:flex; flex-direction:column; gap:10px;
      text-align:right;
      position:relative;
    }
    .feedback-card h2,h3 { margin:0 0 8px 0; font-weight:bold; }

    #feedback-progress-wrapper { width:100%; height:8px; background:rgba(255,255,255,0.2); border-radius:5px; overflow:hidden; margin-bottom:12px; }
    #feedback-progress-fill { width:0%; height:100%; background:#f0c040; border-radius:5px; transition:width 0.3s ease; }

    #feedback-main-form { 
      display:grid; 
      grid-template-columns:1fr 1fr; 
      gap:12px; 
    }
    .feedback-field-group { display:flex; flex-direction:column; opacity:0; transform:translateY(20px); transition:all 0.5s ease; }
    .feedback-field-group.active { opacity:1; transform:translateY(0); }

    #feedback-main-form input,
    #feedback-main-form select,
    #feedback-main-form textarea {
      width:100%;
      height:36px;
      padding:0 12px;
      border-radius:8px;
      border:1px solid #3366aa;
      font-size:0.9rem;
      background:#f8f9fa;
      transition:all 0.3s ease;
      box-sizing:border-box;
    }
    #feedback-main-form textarea { height:80px; padding:8px 12px; }
    #feedback-main-form label { font-weight:bold; margin-bottom:4px; font-size:0.9rem; }

    #feedback-main-form input:focus,
    #feedback-main-form select:focus,
    #feedback-main-form textarea:focus { outline:none; border-color:#f0c040; box-shadow:0 0 8px rgba(240,192,64,0.4); }

    .feedback-action-buttons {
      display:flex; gap:8px; flex-wrap:wrap; margin-top:6px; opacity:0; transform:translateY(20px); transition:all 0.5s ease;
    }
    .feedback-action-buttons.active { opacity:1; transform:translateY(0); }
    .feedback-action-buttons button,.feedback-action-buttons a {
      flex:1; padding:10px 0; font-weight:bold; border-radius:10px; font-size:0.9rem; text-align:center;
      color:#fff; cursor:pointer; text-decoration:none; box-shadow:0 2px 6px rgba(0,0,0,0.15); transition:all 0.3s;
    }
    .feedback-action-buttons button { background:linear-gradient(135deg,#f0c040,#d4af37); border:none; }
    .feedback-action-buttons button:hover { transform:scale(1.05); background:linear-gradient(135deg,#d9b030,#b8941f); }
    .feedback-action-buttons a { background:#4caf50; display:inline-flex; align-items:center; justify-content:center; }
    .feedback-action-buttons a:hover { transform:scale(1.05); background:#388E3C; }

    #feedback-info-items { list-style:none; padding:0; margin-top:6px; text-align:right; direction:rtl; }
    #feedback-info-items li { position:relative; padding-right:18px; margin-bottom:4px; font-size:0.88rem; }
    #feedback-info-items li::before { content:"💬"; position:absolute; right:0; top:0; color:#f0c040; font-weight:bold; }

    #feedback-message-preview { margin-top:8px; font-size:0.88rem; color:#ffd966; white-space:pre-wrap; display:none; }

    @media(max-width:768px){
      #feedback-main-form { grid-template-columns:1fr; gap:8px; }
      .feedback-action-buttons { gap:6px; }
      .feedback-action-buttons button,.feedback-action-buttons a { font-size:0.85rem; padding:8px 0; }
      #feedback-info-items li { font-size:0.83rem; padding-right:14px; }
    }
