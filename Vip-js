(() => {

  document.addEventListener('DOMContentLoaded', initVipSlider);

  async function initVipSlider() {

    const slider = document.getElementById('xlux-slider');
    const indicatorsWrapper = document.getElementById('xlux-indicators');
    const prevBtn = document.querySelector('.xlux-prev');
    const nextBtn = document.querySelector('.xlux-next');

    if (!slider || !indicatorsWrapper) {
      return;
    }

    try {

      const response = await API.get(
        '/site-sections/slider-vip/cars'
      );

      const cars = Array.isArray(response)
        ? response
        : (response.data || []);

      const cardsData = CarMapper.mapList(cars);

      if (!cardsData.length) {
        console.warn(
          'VIP Slider: No cars found'
        );
        return;
      }

      slider.innerHTML = '';
      indicatorsWrapper.innerHTML = '';

      cardsData.forEach((car, index) => {

        const card = document.createElement('div');

        card.className = 'xlux-card';

        card.innerHTML = `

          <a href="${car.link || '#'}">

            <img
              src="${car.cover || ''}"
              alt="${car.title || ''}"
              loading="lazy"
            >

          </a>

          <div class="xlux-card-content">

            <h2 class="xlux-card-title">
              ${car.title || ''}
            </h2>

            <div class="xlux-card-specs">

              <p>
                📅 ${car.year || '-'}
              </p>

              <p>
                🎨 ${car.color || '-'}
              </p>

            </div>
            <div class="xlux-card-row">

              <p>
                ⚙ ${car.gearbox || '-'}
              </p>

            </div>

            <div class="xlux-card-row">

              <p>
                ⛽ ${car.fuel || '-'}
              </p>

            </div>

            <div class="xlux-card-price">

              <span class="xlux-old-price">

                ${car.oldPrice || ''}

              </span>

              <span class="xlux-price">

                ${car.price || ''}

              </span>

            </div>

            <button 
              class="xlux-order-btn"
              data-index="${index}"
            >

              ثبت سفارش

            </button>

          </div>

        `;

        slider.appendChild(card);

        const dot = document.createElement('div');

        dot.className = 'xlux-indicator';

        if (index === 0) {

          dot.classList.add('active');

        }

        indicatorsWrapper.appendChild(dot);

        requestAnimationFrame(() => {

          card.classList.add('show');

        });

      });

      const cards = slider.querySelectorAll('.xlux-card');

      if (!cards.length) {

        return;

      }

      let currentIndex = 0;

      let autoScrollInterval = null;

      const interval = 3000;

      function updateDots() {

        const dots =
          indicatorsWrapper.querySelectorAll(
            '.xlux-indicator'
          );

        dots.forEach((dot, index) => {

          dot.classList.toggle(
            'active',
            index === currentIndex
          );

        });

      }

      function scrollToCard(index) {

        const card = cards[index];

        if (!card) {

          return;

        }

        const sliderCenter =
          slider.clientWidth / 2;

        const cardCenter =
          card.offsetLeft +
          (card.offsetWidth / 2);

        slider.scrollTo({

          left:
            cardCenter - sliderCenter,

          behavior:
            'smooth'

        });

        updateDots();

      }

      function stopAutoScroll() {

        if (autoScrollInterval) {

          clearInterval(
            autoScrollInterval
          );

          autoScrollInterval = null;

        }

      }
      function startAutoScroll() {

        stopAutoScroll();

        autoScrollInterval = setInterval(() => {

          currentIndex++;

          if (currentIndex >= cards.length) {

            currentIndex = 0;

          }

          scrollToCard(currentIndex);

        }, interval);

      }

      function moveSlider(direction) {

        currentIndex =
          (
            currentIndex +
            direction +
            cards.length
          ) % cards.length;

        scrollToCard(currentIndex);

        startAutoScroll();

      }

      if (prevBtn) {

        prevBtn.addEventListener(
          'click',
          () => moveSlider(-1)
        );

      }

      if (nextBtn) {

        nextBtn.addEventListener(
          'click',
          () => moveSlider(1)
        );

      }

      slider.addEventListener(
        'mouseenter',
        stopAutoScroll
      );

      slider.addEventListener(
        'mouseleave',
        startAutoScroll
      );

      slider.addEventListener(
        'touchstart',
        stopAutoScroll,
        {
          passive: true
        }
      );

      slider.addEventListener(
        'touchend',
        startAutoScroll
      );

      window.addEventListener(
        'resize',
        () => {

          scrollToCard(currentIndex);

        }
      );

      slider.addEventListener(
        'click',
        (event) => {

          const btn =
            event.target.closest(
              '.xlux-order-btn'
            );

          if (!btn) {

            return;

          }

          const index =
            btn.dataset.index;

          const car =
            cardsData[index];

          if (!car) {

            return;

          }

          const selectedCar = {

            id:
              car.id,

            title:
              car.title,

            price:
              car.price,

            old_price:
              car.oldPrice,

            year:
              car.year,

            color:
              car.color,

            gearbox:
              car.gearbox,

            fuel:
              car.fuel,

            image:
              car.cover || null

          };

          Storage.Local.set(
            'selectedCar',
            selectedCar
          );

          window.location.href =
            'order.html';

        }
      );

      scrollToCard(0);

      startAutoScroll();

    } catch (error) {

      console.error(
        'VIP Slider Error:',
        error
      );

    }

  }

})();
