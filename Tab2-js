(() => {

'use strict';

const cardsPerPage = 4;

/*

  Tab -> Site Section Mapping

========================================
*/

const TAB_SECTION_MAP = {

  tabSUV: 'new-cars',

  tabSedan: 'used-cars'

};

/*

  Build Product URL

========================================

  IMPORTANT:
  Product navigation is based on the
  car slug returned by the public
  Section Cars API.

  Do NOT depend on:
      car.productUrl

  Product URL contract:

      product.html?slug=<slug>

========================================
*/

function buildProductUrl(slug) {

  if (
    typeof slug !== 'string' ||
    !slug.trim()
  ) {

    return '#';

  }

  return (
    `product.html?slug=${encodeURIComponent(
      slug.trim()
    )}`
  );

}

/*

  Fetch Cars

========================================
*/

async function fetchTabCars(tab) {

  try {

    const sectionSlug =
      TAB_SECTION_MAP[tab];

    if (!sectionSlug) {

      return [];

    }

    const response =
      await API.get(
        `/site-sections/${sectionSlug}/cars`
      );

    const cars =
      Array.isArray(response)
        ? response
        : (response.data || []);

    return CarMapper.mapList(cars);

  } catch (error) {

    console.error(
      'Tab2 Fetch Error:',
      error
    );

    return [];

  }

}

document
.querySelectorAll('[data-widget-two]')
.forEach(async (widget) => {

  const btns =
    widget.querySelectorAll(
      '[data-tab-btns-two] button'
    );

  const contents =
    widget.querySelectorAll(
      '[data-tab-content-two]'
    );

  const cache = {};

  /*
  ========================================
      Load Tabs
  ========================================
  */

  for (const btn of btns) {

    const tab =
      btn.dataset.tab;

    cache[tab] =
      await fetchTabCars(tab);

  }

  /*
  ========================================
      Card Animation
  ========================================
  */

  function animateCards(grid) {

    const cards =
      grid.querySelectorAll(
        '.cars-card-two'
      );

    cards.forEach((card, index) => {

      setTimeout(() => {

        card.classList.add('show');

      }, index * 100);

    });

  }

  /*
  ========================================
      Render Page
  ========================================
  */

  function renderPage(

    grid,

    pagination,

    cars,

    page = 1

  ) {

    if (!cars || cars.length === 0) {

      grid.innerHTML =
        '<p style="padding:20px">خودرویی ثبت نشده</p>';

      pagination.innerHTML = '';

      return;

    }

    const totalPages =
      Math.ceil(
        cars.length / cardsPerPage
      );

    const start =
      (page - 1) * cardsPerPage;

    const pageCars =
      cars.slice(
        start,
        start + cardsPerPage
      );

    grid.innerHTML = '';

    pageCars.forEach((car) => {

      const imageUrl =
        car.cover ||
        'images/placeholder.jpg';

      /*
      ========================================
          Product Navigation

          IMPORTANT:
          The Product URL is built directly
          from the car slug.

          This prevents an empty or stale
          productUrl property from causing:

              href="#"

          which returns the user to the
          current page / top of the page.
      ========================================
      */

      const productUrl =
        buildProductUrl(
          car.slug
        );

      const card =
        document.createElement('div');

      card.className =
        'cars-card-two';

      card.innerHTML = `

        <div class="top-img-two">

          <a href="${productUrl}">

            <img
              src="${imageUrl}"
              alt="${car.title || ''}"
              loading="lazy">

          </a>

        </div>

        <div
          class="bottom-img-two"
          style="background-image:url('${imageUrl}')">
        </div>

        <div class="bottom-overlay-two">

          <div class="left">

            <h3>${car.title || ''}</h3>

            <div class="details">

              <span>
                سال: ${car.year || '-'}
              </span>

              <span>
                کارکرد: ${car.mileage || '-'}
              </span>

              <span>
                قیمت: ${car.price || '-'}
              </span>

            </div>

          </div>

          <a
            href="#"
            class="btn order-btn-two"
            data-car='${JSON.stringify({

              id: car.id,

              slug: car.slug,

              title: car.title,

              price: car.price,

              oldPrice: car.oldPrice,

              year: car.year,

              mileage: car.mileage,

              color: car.color,

              gearbox: car.gearbox,

              fuel: car.fuel,

              image: imageUrl

            })}'>

            ثبت سفارش

          </a>

        </div>

      `;

      grid.appendChild(card);

      /*
      ========================================
          Order Button
      ========================================
      */

      const orderBtn =
        card.querySelector(
          '.order-btn-two'
        );

      orderBtn?.addEventListener(
        'click',
        (event) => {

          event.preventDefault();

          const carData =
            JSON.parse(
              orderBtn.dataset.car
            );

          Storage.Local.set(

            Storage.KEYS.SELECTED_CAR,

            carData

          );

          window.location.href =
            'order.html';

        }
      );

    });

    /*
    ========================================
        Pagination
    ========================================
    */

    pagination.innerHTML = '';

    const left =
      document.createElement('div');

    left.className =
      'page-btn-two';

    left.textContent = '‹';

    left.onclick = () => {

      if (page > 1) {

        renderPage(

          grid,

          pagination,

          cars,

          page - 1

        );

      }

    };

    pagination.appendChild(left);

    for (

      let i = 1;

      i <= totalPages;

      i++

    ) {

      const sq =
        document.createElement('div');

      sq.className =
        'page-square-two' +
        (
          i === page
            ? ' active'
            : ''
        );

      sq.textContent = i;

      sq.onclick = () =>

        renderPage(

          grid,

          pagination,

          cars,

          i

        );

      pagination.appendChild(sq);

    }

    const right =
      document.createElement('div');

    right.className =
      'page-btn-two';

    right.textContent = '›';

    right.onclick = () => {

      if (page < totalPages) {

        renderPage(

          grid,

          pagination,

          cars,

          page + 1

        );

      }

    };

    pagination.appendChild(right);

    setTimeout(() => {

      animateCards(grid);

    }, 50);

  }

  /*
  ========================================
      Tab Click
  ========================================
  */

  btns.forEach((btn) => {

    btn.addEventListener(

      'click',

      () => {

        btns.forEach((b) =>

          b.classList.remove('active')

        );

        contents.forEach((c) =>

          c.classList.remove('active')

        );

        btn.classList.add('active');

        const activeTab =

          widget.querySelector(

            '#' + btn.dataset.tab

          );

        activeTab.classList.add(

          'active'

        );

        renderPage(

          activeTab.querySelector(

            '[data-grid-two]'

          ),

          activeTab.querySelector(

            '[data-pagination-two]'

          ),

          cache[btn.dataset.tab]

        );

      }

    );

  });

  /*
  ========================================
      Initial Render
  ========================================
  */

  contents.forEach((tab) => {

    const grid =
      tab.querySelector(
        '[data-grid-two]'
      );

    const pagination =
      tab.querySelector(
        '[data-pagination-two]'
      );

    renderPage(

      grid,

      pagination,

      cache[tab.id]

    );

  });

});

})();
