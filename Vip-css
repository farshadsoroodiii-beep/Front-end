.xlux-slider-section { width:100%; padding:40px 0; display:flex; justify-content:center; position:relative; }
.xlux-slider-container { width:100%; max-width:1200px; display:flex; overflow-x:auto; gap:20px; scroll-behavior:smooth; padding-bottom:20px; }
.xlux-slider-container::-webkit-scrollbar { display:none; }

.xlux-card { position:relative; flex:0 0 400px; height:240px; border-radius:8px; overflow:hidden; cursor:pointer; transition: transform 0.3s ease; }
.xlux-card:hover { transform: scale(1.05); }

.xlux-card img { width:100%; height:100%; object-fit:cover; transition: transform 0.5s ease; display:block; }

.xlux-card-content {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:25px 30px 25px 25px;
  gap:2px;
  color:#fff;
  text-shadow:2px 2px 5px rgba(0,0,0,0.8);
  text-align:right;
  box-sizing: border-box;
  /* 🔧 اضافه‌شده برای فعال شدن کلیک روی عکس */
  pointer-events: none;
}

.xlux-card-content * { line-height:1.2; margin:0; }

.xlux-order-btn {
  display:inline-block;
  padding:8px 18px;
  background: linear-gradient(135deg,#053a54,#016a90);
  color:#fff;
  font-weight:bold;
  border-radius:8px;
  font-size:11px;
  text-decoration:none;
  backdrop-filter:blur(5px);
  border:1px solid rgba(255,255,255,0.3);
  transition: all 0.3s ease;
  margin-top:8px;
  width:max-content;
  /* 🔧 دکمه همچنان کلیک‌پذیر می‌ماند */
  pointer-events: auto;
}

.xlux-order-btn:hover {
  background: linear-gradient(135deg,#064b6d,#0e95c6);
  transform: scale(1.05);
}

.xlux-card-title { font-size:18px; }
.xlux-card-specs { display:flex; flex-wrap:wrap; gap:8px; font-size:12px; }
.xlux-card-row { display:flex; gap:8px; font-size:12px; }
.xlux-card-price { font-size:14px; font-weight:bold; margin-top:8px; }
.xlux-old-price { text-decoration:line-through; margin-right:15px; opacity:0.7; }
.xlux-price { color:#fff; }

.xlux-slider-nav { position:absolute; top:50%; transform:translateY(-50%); width:45px; height:45px; background: rgba(5,42,68,0.5);
  border:none; border-radius:50%; color:#fff; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center; z-index:10;
  transition: all 0.3s ease; }
.xlux-slider-nav:hover { transform: translateY(-50%) scale(1.15); background: rgba(5,42,68,0.8); }
.xlux-prev { left:8px; }
.xlux-next { right:8px; }

.xlux-indicator-wrapper { display:flex; gap:5px; justify-content:center; position:absolute; bottom:5px; width:100%; }
.xlux-indicator { width:9px; height:9px;   background: linear-gradient(135deg,#053a54,#016a90); border-radius:50%; transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
.xlux-indicator.active { background:#fff; transform: scale(1.3); }

@media(max-width:768px){
  .xlux-card { flex:0 0 280px; height:180px; }
  .xlux-card-content { padding: 15px 25px 15px 15px; gap:2px; }
  .xlux-card-title { font-size:14px; }
  .xlux-card-specs, .xlux-card-row { font-size:11px; }
  .xlux-card-price { font-size:13px; margin-top:5px; }
  .xlux-order-btn { font-size:10px; padding:8px 10px; margin-top:5px; }
  .xlux-indicator { width:7px; height:7px; }
}
